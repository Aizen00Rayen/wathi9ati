# ─── Wathi9ati PHP backend configuration ─────────────────────────────────────
# Copy this file to `.env` (place it in public_html/, one level above api/).
# Generate strong secrets, e.g.:  php -r "echo bin2hex(random_bytes(32));"

# JWT signing secrets — CHANGE THESE IN PRODUCTION
JWT_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin (used for CORS in development; same-origin in production)
FRONTEND_URL=http://localhost:5173

# production | development  — controls the Secure flag on the refresh cookie
NODE_ENV=production

# Max PDF upload size (megabytes)
MAX_FILE_SIZE_MB=10

# Where the SQLite DB + uploaded PDFs live. Defaults to <public_html>/storage
# (protected by storage/.htaccess). For extra safety point it OUTSIDE the web
# root, e.g. STORAGE_PATH=/home/USER/wathi9ati-storage
# STORAGE_PATH=

# Resend API key for the contact form (leave blank to just store messages in DB)
RESEND_API_KEY=
CONTACT_FROM=وثيقتي <noreply@wathi9ati.space>
CONTACT_TO=contact@wathi9ati.space
